# Copy to .env.local for local development. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Supabase (M1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used yet; needed by the M4 scheduler.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (M3+) — server-side only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web push (M4)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
