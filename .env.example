# Copy to .env.local for local development. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Supabase (M1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used yet; needed by the M4 scheduler.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (M3+) — server-side only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Schedulers: nightly tagging (Vercel Cron → /api/partner/tag) and the push tick every 5 min
# (Supabase pg_cron → /api/push/tick). Any long random string; set the same in Vercel AND in
# Supabase Vault as 'push_tick_secret' (see docs/STATUS.md).
CRON_SECRET=

# Web push (M4). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
